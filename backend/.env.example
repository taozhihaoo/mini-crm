# ClientFlow CRM backend - example environment configuration.
# Copy to .env and adjust. Never commit your real .env file.

# PostgreSQL (used by Docker Compose):
# DATABASE_URL=postgresql+psycopg://clientflow:clientflow-demo@localhost:5432/clientflow
# SQLite fallback for quick local runs (no infrastructure required):
DATABASE_URL=sqlite:///./clientflow.local.db

# Runtime mode: "development" | "demo" | "production".
# - development/demo: may use the built-in development secret and seed demo data.
# - production: REQUIRES an explicit SECRET_KEY; SEED_DEMO_DATA=true is rejected at startup.
ENVIRONMENT=development

# JWT signing secret. REQUIRED in any shared/production environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-any-shared-environment
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed CORS origins (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# AI provider: "mock" (default, fully offline, deterministic) or "openai".
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=openai. Inject at runtime; never commit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to true to seed the demo dataset automatically on startup (Docker Compose does this).
SEED_DEMO_DATA=false

ENVIRONMENT=development
