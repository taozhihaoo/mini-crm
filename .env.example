# ClientFlow CRM - root environment example (used by docker compose).
# Copy to .env to override the demo defaults. Never commit a real .env.

# Runtime mode: "development" | "demo" | "production".
# - development/demo: may use the built-in development secret and seed demo data.
# - production: REQUIRES an explicit SECRET_KEY; SEED_DEMO_DATA=true is rejected at startup.
ENVIRONMENT=demo

# PostgreSQL password for the demo stack (demo-only default).
POSTGRES_PASSWORD=clientflow-demo

# JWT signing secret. REQUIRED to change in any shared environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AI provider: "mock" (default, deterministic, offline) or "openai".
LLM_PROVIDER=mock
# Inject at runtime only - required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seed the fictional demo dataset on first start.
SEED_DEMO_DATA=true
